{
  "rules": {
    "bw": {
      "rooms": {
        "$room": {
          "p": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && $room.matches(/^mm-[a-z0-9]{6}$/)",
            "$peer": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && $room.matches(/^mm-[a-z0-9]{6}$/) && $peer.beginsWith(auth.uid + '_')",
              ".validate": "newData.hasChildren(['s', 't']) && newData.child('s').isString() && newData.child('s').val().length <= 4096 && newData.child('t').val() === now",
              "$other": {
                ".validate": "$other === 's' || $other === 't'"
              }
            }
          },
          "m": {
            ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && $room.matches(/^mm-[a-z0-9]{6}$/)",
            "$peer": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && $room.matches(/^mm-[a-z0-9]{6}$/) && $peer.beginsWith(auth.uid + '_')",
              ".indexOn": [
                "t"
              ],
              "$id": {
                ".validate": "newData.hasChildren(['d', 't']) && newData.child('d').isString() && newData.child('d').val().length <= 80000 && newData.child('t').val() === now",
                "$other": {
                  ".validate": "$other === 'd' || $other === 't'"
                }
              }
            }
          },
          "in": {
            "$peer": {
              ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && $peer.beginsWith(auth.uid + '_')",
              ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && $peer.beginsWith(auth.uid + '_') && !newData.exists()",
              ".indexOn": [
                "t"
              ],
              "$id": {
                ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && $room.matches(/^mm-[a-z0-9]{6}$/) && ((!data.exists() && newData.child('u').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('u').val() === auth.uid))",
                ".validate": "newData.hasChildren(['u', 'f', 'd', 't']) && newData.child('f').isString() && newData.child('f').val().matches(/^[a-z0-9]{6,16}$/) && newData.child('d').isString() && newData.child('d').val().length <= 80000 && newData.child('t').val() === now",
                "$other": {
                  ".validate": "$other === 'u' || $other === 'f' || $other === 'd' || $other === 't'"
                }
              }
            }
          }
        }
      },
      "admin": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "on": {
        ".read": "auth != null",
        "$k": {
          ".write": "auth != null && $k.beginsWith(auth.uid + '_') && $k.matches(/^[A-Za-z0-9]{1,128}_[a-z0-9]{6,16}$/)",
          ".validate": "newData.hasChildren(['t']) && newData.child('t').isNumber() && (!newData.child('g').exists() || newData.child('g').val() === (auth.token.firebase.sign_in_provider === 'google.com'))",
          "$o": {
            ".validate": "$o === 't' || $o === 'g'"
          }
        }
      },
      "who": {
        ".read": "auth != null && root.child('bw/admin/' + auth.uid).val() === true",
        "$k": {
          ".write": "auth != null && $k.beginsWith(auth.uid + '_') && $k.matches(/^[A-Za-z0-9]{1,128}_[a-z0-9]{6,16}$/)",
          ".validate": "newData.hasChildren(['t', 's', 'at']) && newData.child('t').isNumber() && newData.child('s').isNumber() && newData.child('at').isString() && newData.child('at').val().length <= 12 && (!newData.child('n').exists() || (newData.child('n').isString() && newData.child('n').val().length <= 60)) && (!newData.child('g').exists() || newData.child('g').val() === (auth.token.firebase.sign_in_provider === 'google.com'))",
          "$o": {
            ".validate": "$o === 't' || $o === 's' || $o === 'at' || $o === 'n' || $o === 'g'"
          }
        }
      },
      "chat": {
        ".read": "auth != null",
        ".indexOn": [
          "t"
        ],
        "$m": {
          ".write": "(!data.exists() && newData.exists() && auth != null && auth.token.firebase.sign_in_provider === 'google.com' && !root.child('bw/chatban/' + auth.uid).exists() && newData.child('u').val() === auth.uid && newData.parent().parent().child('chatlast/' + auth.uid).val() === now) || (data.exists() && !newData.exists() && auth != null && (root.child('bw/admin/' + auth.uid).val() === true || data.child('u').val() === auth.uid || data.child('t').val() < (now - ((now + 25200000) % 86400000))))",
          ".validate": "newData.hasChildren(['u', 'n', 'm', 't']) && newData.child('t').val() === now && newData.child('m').isString() && newData.child('m').val().length >= 1 && newData.child('m').val().length <= 300 && newData.child('n').isString() && newData.child('n').val().length <= 100 && (newData.child('n').val() === auth.token.name || (auth.token.name == null && newData.child('n').val() === 'ไม่ระบุชื่อ'))",
          "$o": {
            ".validate": "$o === 'u' || $o === 'n' || $o === 'm' || $o === 't'"
          }
        }
      },
      "chatlast": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && newData.val() === now && (!data.exists() || data.val() < now - 3000)"
        }
      },
      "chatban": {
        ".read": "auth != null && root.child('bw/admin/' + auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && root.child('bw/admin/' + auth.uid).val() === true",
          ".validate": "newData.isBoolean()"
        }
      },
      "users": {
        ".read": "auth != null && root.child('bw/admin/' + auth.uid).val() === true",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['t']) && newData.child('t').isNumber() && (!newData.child('n').exists() || (newData.child('n').isString() && newData.child('n').val().length <= 60)) && (!newData.child('g').exists() || newData.child('g').val() === (auth.token.firebase.sign_in_provider === 'google.com'))",
          "$o": {
            ".validate": "$o === 't' || $o === 'f' || $o === 'n' || $o === 'g' || $o === 'cloud'"
          }
        }
      },
      "log": {
        ".read": "auth != null && root.child('bw/admin/' + auth.uid).val() === true",
        ".write": "auth != null && root.child('bw/admin/' + auth.uid).val() === true",
        "$day": {
          "$e": {
            ".write": "auth != null && !data.exists() && newData.child('u').val() === auth.uid",
            ".validate": "$day.matches(/^20[0-9]{2}-[01][0-9]-[0-3][0-9]$/) && newData.hasChildren(['u', 'k', 't']) && (newData.child('k').val() === 'in' || newData.child('k').val() === 'out') && newData.child('t').isNumber() && (!newData.child('g').exists() || newData.child('g').val() === (auth.token.firebase.sign_in_provider === 'google.com')) && (!newData.child('n').exists() || (newData.child('n').isString() && newData.child('n').val().length <= 60))",
            "$o": {
              ".validate": "$o === 'u' || $o === 'k' || $o === 't' || $o === 'g' || $o === 'n'"
            }
          }
        }
      },
      "stat": {
        ".read": "auth != null && root.child('bw/admin/' + auth.uid).val() === true",
        ".write": "auth != null && root.child('bw/admin/' + auth.uid).val() === true",
        "$day": {
          ".validate": "$day.matches(/^20[0-9]{2}-[01][0-9]-[0-3][0-9]$/)",
          "in": {
            ".write": "auth != null",
            ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          },
          "u": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isBoolean()"
            }
          },
          "g": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com'",
              ".validate": "newData.isBoolean()"
            }
          },
          "$other": {
            ".validate": "false"
          }
        }
      },
      "maps": {
        ".read": "auth != null && root.child('bw/admin/' + auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "(auth != null && auth.uid === $uid) || (auth != null && root.child('bw/admin/' + auth.uid).val() === true && !newData.exists())",
          "$map": {
            ".validate": "$map.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['d', 'at']) && newData.child('d').isString() && newData.child('d').val().length <= 8000000 && newData.child('at').isNumber()"
          }
        }
      },
      "mapix": {
        ".read": "auth != null && root.child('bw/admin/' + auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "(auth != null && auth.uid === $uid) || (auth != null && root.child('bw/admin/' + auth.uid).val() === true && !newData.exists())",
          "$map": {
            ".validate": "$map.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['title', 'at', 'size']) && newData.child('title').isString() && newData.child('title').val().length <= 80 && newData.child('at').isNumber() && newData.child('size').isNumber()"
          }
        }
      }
    }
  }
}